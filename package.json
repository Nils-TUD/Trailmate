{
    "name": "trailmate",
    "version": "0.1.0",
    "private": true,
    "description": "Repository opt-in and automated model attribution for OpenCode",
    "type": "module",
    "main": "./dist/server.js",
    "exports": {
        ".": "./dist/server.js",
        "./server": "./dist/server.js",
        "./tui": "./dist/tui.js",
        "./server-v1": "./dist/server-v1.js",
        "./tui-v1": "./dist/tui-v1.js"
    },
    "files": [
        "dist",
        "README.md",
        "docs"
    ],
    "engines": {
        "node": ">=22",
        "opencode": ">=1.18.4 <2 || >=2.1.3 <3"
    },
    "scripts": {
        "build": "tsc && cp src/hook.py dist/hook.py",
        "check": "tsc --noEmit",
        "format": "prettier --write .",
        "format:check": "prettier --check .",
        "test": "npm run build && node --test test/*.test.mjs",
        "test:smoke": "npm run build && node test/smoke.mjs"
    },
    "devDependencies": {
        "@opencode-ai/plugin": "1.18.4",
        "@opencode/plugin": "2.1.3",
        "@types/node": "^24.0.0",
        "prettier": "3.9.10",
        "typescript": "^5.8.3"
    }
}
